# Server-side named data sources for the controlled query demo.
# The guest only ever sees the id; URL and bearer value stay on the host.
export SANDBOX_SOURCES='{
  "device_specs": {
    "url": "http://127.0.0.1:8091/specs",
    "param": "model",
    "auth_header_name": "Authorization",
    "auth_header_value": "Bearer demo-token-123"
  }
}'
